# Copy this file to .env and fill in the real values.
# .env must never be committed.

PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
NODE_ENV=development

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ---- Email (Gmail App Password, not the normal account password) ----
# Google Account > Security > 2-Step Verification > App passwords
EMAIL_SERVICE=gmail
EMAIL_USER=yourstore@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=yourstore@gmail.com

# ---- Brand / links used inside transactional emails ----
STORE_NAME=ANTIQOR
STORE_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000
SUPPORT_EMAIL=yourstore@gmail.com
